USE_RAG=false
FAISS_INDEX_DIR=backend/artifacts/artifacts/faiss_data_natural
CLINICALBERT_MODEL_DIR=backend/artifacts/artifacts/clinicalbert_classifier_natural
ALLOW_UNSAFE_PICKLE_METADATA=false

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL_NAME=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=GP Medical Analysis

# Legacy Gemini aliases (still supported for backward compatibility)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash-lite
ENABLE_THERAPY=false
PIPELINE_TIMEOUT_SECONDS=120
REQUIRE_SERVICE_API_KEY=false
SERVICE_API_KEY=
DATABASE_URL=sqlite:///backend/chatbot.db
JWT_SECRET_KEY=change-this-local-dev-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
RAG_TOP_K=5
RAG_TRANSLATE_ARABIC=true

USE_FINETUNED_CLASSIFIER=false
FINETUNED_MODEL_DIR=backend/artifacts/artifacts/clinicalbert_classifier_natural
CLASSIFIER_MAX_LENGTH=256
CLASSIFIER_TRANSLATE_ARABIC=true

MENTAL_HEALTH_MODEL_DIR=backend/artifacts/artifacts/mental_health/complaint_model_final
MENTAL_HEALTH_ENABLED=true
MENTAL_HEALTH_LOAD_IN_4BIT=true
MENTAL_HEALTH_MAX_NEW_TOKENS=400
MENTAL_HEALTH_DEVICE=auto
